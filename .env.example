# ─── Database ────────────────────────────────────────────────────────────────
# Local dev only (SQLite file). In production, D1 is injected via Cloudflare env binding.
DATABASE_URL=file:./prisma/dev.db

# ─── Clerk Authentication ─────────────────────────────────────────────────────
# Required: Get from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk webhook secret (for /api/webhooks/clerk)
CLERK_WEBHOOK_SECRET=whsec_...

# Clerk redirect URLs (defaults work for localhost:3000)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ─── Anthropic (AI Call Handling) ─────────────────────────────────────────────
# Required for AI features. Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── Twilio (Voice + SMS) ─────────────────────────────────────────────────────
# Required for call handling and SMS dispatch
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+18135550100

# Twilio webhook signature validation
TWILIO_WEBHOOK_BASE_URL=https://smb.cafecito-ai.com

# ─── Stripe (Payments) ────────────────────────────────────────────────────────
# Optional: Required for customer payment collection
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Optional: Required for invoice/quote email delivery
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ─── Observability (Optional) ─────────────────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
